{
  "manifest_version": 3,
  "name": "KVPV — Đồng bộ tab game",
  "version": "1.0.0",
  "minimum_chrome_version": "125",
  "description": "Đồng bộ FULL từ dự án trên máy vào tab Kiếm Vũ Phong Vân đang mở.",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KVPV đồng bộ",
    "default_popup": "popup.html"
  },
  "key": ""
}
