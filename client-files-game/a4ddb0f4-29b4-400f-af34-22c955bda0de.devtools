    _t[19] = 'S\u1ed1 l\u1ea7n t\u1eed vong \u0111\u1ea1t<span style = "color: #e2fb93">%d l\u1ea7n</span>\u0110\u01b0\u1ee3cNh\u1eadn%sK\u1ef9 n\u0103ng!', 
    _t[20] = 'Sau khi r\u1eddi b\u1ea3n \u0111\u1ed3, C\u1ea7n&nbsp;<span style="color:#FF3E3E">Ch\u1edd%d gi\xe2y</span>&nbsp;m\u1edbi \u0111\u01b0\u1ee3c v\xe0o l\u1ea1i, C\xf3 x\xe1cNh\u1eadn r\u1eddi kh\u1ecfi\uff1f', 
    _t[21] = "C\xf3 ph\u1ea7n th\u01b0\u1edfng ch\u01b0aNh\u1eadn trong l\u1ecbch s\u1eed thu nh\u1eadp,\u0110\u1ed3ng \xfd \u0111\u1ebfnNh\u1eadn?", 
