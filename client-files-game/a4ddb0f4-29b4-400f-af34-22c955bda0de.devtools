    _t[10] = "peak_arena_atlas/image_jingji_dfdingtxt%d.jpg", _t[11] = "S\u1ed1 t\u1ea7ng c\u1ee7a \u0110\u1ed9i Tr\u01b0\u1edfng v\xe0 b\u1ea1n kh\xe1c nhau, Gia nh\u1eadp s\u1ebd theo s\u1ed1 t\u1ea7ng c\u1ee7a \u0110\u1ed9i Tr\u01b0\u1edfng \u0111\u1ec3 khi\xeau chi\u1ebfn, \u0110\u1ed3ng \xfd gia nh\u1eadp?", 
    _t[12] = "Nh\u1eafc nh\u1edf", _t[13] = "Ch\u01b0a c\xf3 th\xf4ng tin B\xe1 Ch\u1ee7 m\u1ea1nh nh\u1ea5t! ", 
